# Backend GeoQuest API (ver D:\Repos\GeoQuest, dotnet run, http://localhost:5219 por defecto).
VITE_API_BASE_URL=http://localhost:5219

# Token público de Mapbox (mapa de descubrimiento de lugares, WU003b). Sin
# él, la app degrada a modo solo-lista (ver src/features/map/map-config.ts).
VITE_MAPBOX_TOKEN=

# Overrides opcionales para el centro por defecto del mapa cuando el GPS del
# dispositivo se deniega o expira. Ambos deben estar presentes y ser números
# válidos para tomar efecto; si falta alguno, el fallback es Medellín.
VITE_MAP_DEFAULT_LAT=
VITE_MAP_DEFAULT_LNG=